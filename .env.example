# ==============================================================================
# AEGIS INVEST — Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Metadata
# ------------------------------------------------------------------------------
APP_NAME=aegis-invest
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# ------------------------------------------------------------------------------
# API Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Security & CORS
# In production, set specific comma-separated allowed origins (e.g. https://aegis.domain.com)
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-secret-key-aegis
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
# SQLite fallback for unit testing: sqlite+aiosqlite:///./aegis_test.db
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://aegis_user:aegis_password@localhost:5432/aegis_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# Caching & Message Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# LLM AI Reasoning Provider Configuration
# ------------------------------------------------------------------------------
# Option 1: Internal Institutional Deterministic Engine (Default - zero external API required)
LLM_PROVIDER=AEGIS_INTERNAL_DETERMINISTIC
LLM_MODEL=aegis-institutional-v1

# Option 2: Qwen LLM Provider (Alibaba Cloud DashScope / OpenAI-compatible endpoint)
# LLM_PROVIDER=QWEN
# LLM_MODEL=qwen3-32b
# QWEN_API_KEY=your_qwen_dashscope_api_key_here
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Generic API keys for fallback or alternative providers
LLM_API_KEY=

MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=

NEWS_PROVIDER=demo_news
NEWS_API_KEY=

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# Client-accessible variables must be prefixed with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=AEGIS INVEST
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
